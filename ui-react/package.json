{
  "name": "liquid-bridge-poc-ui-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "React interface for the Sepolia/Liquid testnet bridge. Reuses ../ui/lib and ../ui/config.js read-only; builds to a static site for GitHub Pages.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixture": "vite --mode fixture",
    "build": "vite build",
    "build:fixture": "vite build --mode fixture --outDir dist-fixture",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check src/styles/app.css",
    "test": "vitest run",
    "screens": "node scripts/screens.mjs",
    "check:layout": "node scripts/screens.mjs --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^27.0.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.0"
  }
}
